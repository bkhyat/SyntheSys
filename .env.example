# Google Gemini API key (optional if using local/remote Ollama)
GEMINI_API_KEY=your_gemini_api_key

# Ollama LLM configuration (for local or SSH port-forwarded Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma:12b

# LLM Provider Preference: auto | gemini | ollama | mock
LLM_PROVIDER=auto

# ====================================================================
# Full-Text Manuscript Retrieval APIs (Open Access)
# ====================================================================
# Unpaywall / OpenAlex Contact Email (Recommended)
# Used to access Unpaywall's free API and OpenAlex's fast "polite" pool.
# No password or payment required; any valid contact email works.
UNPAYWALL_EMAIL=your_email@domain.com
OPENALEX_EMAIL=your_email@domain.com

# Semantic Scholar API Key (Optional)
# Public rate limits work out-of-the-box. Add key if you have high volume.
# https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# NCBI API Key (Optional, for higher rate limits on PubMed / PMC)
# https://ncbiinsights.ncbi.nlm.nih.gov/2017/11/02/new-api-keys-for-the-e-utilities/
NCBI_API_KEY=